rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function adminRecord() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function hasRole(roles) {
      return signedIn() && adminRecord().data.active == true &&
        adminRecord().data.role in roles;
    }
    function isOwner() { return hasRole(['owner']); }
    function isContentEditor() { return hasRole(['owner', 'editor']); }
    function isStaff() { return hasRole(['owner', 'staff']); }
    function isOperationsReader() { return hasRole(['owner', 'staff', 'viewer']); }

    // Public content is intentionally in separate collections from private CRM.
    match /siteContent/{documentId} {
      allow read: if true;
      allow create, update, delete: if isContentEditor();
    }
    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isContentEditor();
    }
    match /projects/{projectId} {
      // The public portfolio section was removed. Drafts and records stay private.
      allow read: if isOperationsReader() || isContentEditor();
      allow create, update, delete: if isContentEditor();
    }

    function validPublicRequest() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'fullName','email','phone','service','message','requestType',
          'requestedDate','privacyAcknowledged','privacyVersion','source',
          'status','createdAt'
        ]) &&
        d.keys().hasAll([
          'fullName','email','phone','service','message','requestType',
          'requestedDate','privacyAcknowledged','privacyVersion','source',
          'status','createdAt'
        ]) &&
        d.fullName is string && d.fullName.size() >= 2 && d.fullName.size() <= 100 &&
        d.email is string && d.email.size() <= 160 &&
        d.email.matches('^[^ @]+@[^ @]+\\.[^ @]+$') &&
        d.phone is string && d.phone.size() <= 40 &&
        d['service'] is string && d['service'].size() <= 80 &&
        d.message is string && d.message.size() >= 10 && d.message.size() <= 2500 &&
        d.requestType in ['preventivo','appuntamento'] &&
        d.requestedDate is string && d.requestedDate.size() <= 10 &&
        (d.requestedDate == '' || d.requestedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')) &&
        (d.requestType != 'appuntamento' || d.requestedDate.size() == 10) &&
        d.privacyAcknowledged == true &&
        d.privacyVersion == '2026-10' &&
        d.source == 'website' && d.status == 'nuova' &&
        d.createdAt == request.time;
    }
    match /requests/{requestId} {
      allow create: if validPublicRequest() || isStaff();
      allow get, list: if isOperationsReader();
      allow update, delete: if isStaff();
    }
    match /clients/{clientId} {
      allow get, list: if isOperationsReader();
      allow create, update, delete: if isStaff();
    }
    match /appointments/{appointmentId} {
      allow get, list: if isOperationsReader();
      allow create, update, delete: if isStaff();
    }
    match /quotes/{quoteId} {
      allow get, list: if isOperationsReader();
      allow create, update, delete: if isStaff();
    }

    // Bootstrap the first owner manually in Firebase Console.
    // Never create a public self-registration path for privileged roles.
    match /admins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();
      allow create: if isOwner() &&
        request.resource.data.role in ['owner','editor','staff','viewer'] &&
        request.resource.data.active is bool;
      allow update: if isOwner() &&
        request.resource.data.role in ['owner','editor','staff','viewer'] &&
        request.resource.data.active is bool &&
        (uid != request.auth.uid ||
         (request.resource.data.active == true && request.resource.data.role == 'owner'));
      allow delete: if isOwner() && uid != request.auth.uid;
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
