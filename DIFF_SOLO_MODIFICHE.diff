 function requestTable(data,compact=false){return data.length?`<table class="list-table"><thead><tr><th>CONTATTO</th><th>SERVIZIO</th><th>DATA</th><th>STATO</th><th></th></tr></thead><tbody>${data.map(r=>`<tr><td><span class="strong">${esc(r.fullName)}</span><br><span class="text-muted">${esc(r.email)}</span></td><td>${esc(r.service)}</td><td>${date(r.createdAt)}</td><td>${status(r.status)}</td><td><button class="action-icon" data-open="request" data-id="${esc(r.id)}" aria-label="Apri richiesta">↗</button></td></tr>`).join('')}</tbody></table>`:empty('Nessuna richiesta','Gli invii del modulo pubblico compariranno qui.')}
